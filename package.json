{
	"name": "rhythm-napi-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run @rhythm-app/streamer#compile",
		"test": "vp run workspace:test",
		"check": "vp check",
		"fix": "vp check --fix",
		"verify": "vp run --concurrency-limit 2 workspace:verify",
		"hooks:install": "hk install --mise",
		"catalog:migrate": "pncat migrate --yes",
		"catalog:detect": "pncat detect --yes"
	},
	"devDependencies": {
		"vite-plus": "catalog:build",
		"pncat": "catalog:tooling"
	},
	"packageManager": "pnpm@11.28.2"
}
